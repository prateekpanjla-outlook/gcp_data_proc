# Dockerfile for GitHub Archive Phase 2 File Splitter Job
# Splits large files (>500MB) into smaller chunks for parallel processing

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# Install dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    gzip \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r appuser && useradd -r -g appuser appuser

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY . .

RUN mkdir -p /tmp/processing && \
    chown -R appuser:appuser /app /tmp

USER appuser

# File splitter runs as a job, not a service
# It will be invoked with command-line arguments
CMD ["python", "-m", "github_archive.phase2_process_files.processors.file_splitter"]
